<div class="banner">
  <div class="container">
    <h1>My Movie Lists</h1>
    <p>Create and manage your favorite movie collections 🎬</p>

    <%= link_to "Create a new list", new_list_path, class: "btn btn-flat" %>
  </div>
</div>

<div class="container mt-4">

  <div class="cards">
    <% @lists.each do |list| %>

      <div class="card-category" >
        <%= link_to list.name, list_path(list), class: "text-decoration-none text-white" %>
      </div>

    <% end %>
  </div>

</div>
